<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    
    <!-- Include Spring Boot's default configuration -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    
    <!-- Define console log pattern -->
    <property name="CONSOLE_LOG_PATTERN" 
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <!-- Console Appender - Only logging method -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- All profiles use only console logging -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        
        <!-- Application specific loggers -->
        <logger name="br.com.comprae.produto" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
        
        <!-- Cache and Redis logging -->
        <logger name="org.springframework.cache" level="DEBUG"/>
        <logger name="org.springframework.data.redis" level="DEBUG"/>
        
        <!-- Resilience4j logging -->
        <logger name="io.github.resilience4j" level="DEBUG"/>
        
        <!-- OpenTelemetry logging -->
        <logger name="io.opentelemetry" level="INFO"/>
        
        <!-- Metrics logging -->
        <logger name="io.micrometer" level="INFO"/>
    </springProfile>

    <springProfile name="docker">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        
        <!-- Application specific loggers -->
        <logger name="br.com.comprae.produto" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
        
        <!-- Reduced logging for production-like environment -->
        <logger name="org.springframework.cache" level="WARN"/>
        <logger name="org.springframework.data.redis" level="WARN"/>
        <logger name="io.github.resilience4j" level="INFO"/>
        <logger name="io.opentelemetry" level="WARN"/>
        <logger name="io.micrometer" level="WARN"/>
    </springProfile>

    <springProfile name="test">
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
        
        <!-- Application specific loggers for testing -->
        <logger name="br.com.comprae.produto" level="DEBUG" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
        
        <!-- Suppress noisy loggers during tests -->
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>
        <logger name="org.apache" level="WARN"/>
        <logger name="com.zaxxer.hikari" level="WARN"/>
        <logger name="org.testcontainers" level="INFO"/>
    </springProfile>

    <!-- Default configuration (prod-like) - Only console -->
    <springProfile name="!dev &amp; !docker &amp; !test">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        
        <!-- Application specific loggers -->
        <logger name="br.com.comprae.produto" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
        </logger>
        
        <!-- Production logging levels -->
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.hibernate" level="WARN"/>
        <logger name="io.github.resilience4j" level="INFO"/>
        <logger name="io.opentelemetry" level="WARN"/>
        <logger name="io.micrometer" level="WARN"/>
    </springProfile>

</configuration>